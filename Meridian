  <script>
    // ========== Helpers ==========
    const $ = (id) => document.getElementById(id);
    const fmt = (n, d = 2) => {
      if (n == null || isNaN(n)) return '—';
      return Number(n).toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
    };
    const fmtPct = (n) => (n == null || isNaN(n) ? '—' : (n >= 0 ? '+' : '') + fmt(n, 2) + '%');
    const sleep = (ms) => new Promise(r => setTimeout(r, ms));

    // ========== State ==========
    let market = {
      symbol: 'BTCUSDT',
      price: null,
      change24h: null,
      funding: null,
      oi: null,
      lsRatio: null,
      mark: null,
      index: null,
      high24: null,
      low24: null
    };

    // ========== Chat UI ==========
    function addMsg(role, html, isTyping = false) {
      const chat = $('chat');
      const div = document.createElement('div');
      div.className = role === 'user'
        ? 'flex justify-end'
        : 'flex justify-start';
      div.innerHTML = `
        <div class="max-w-[90%] sm:max-w-[80%] rounded-2xl px-4 py-3 ${
          role === 'user'
            ? 'bg-brand-600/20 border border-brand-500/30 text-slate-100'
            : 'bg-slate-800/80 border border-slate-700/60 text-slate-300'
        }">
          ${isTyping ? '<span class="typing">Analyzing market structure<span>.</span><span>.</span><span>.</span></span>' : html}
        </div>`;
      chat.appendChild(div);
      chat.scrollTop = chat.scrollHeight;
      return div;
    }

    // ========== Fetch Market Data (public Binance) ==========
    async function fetchMarket(symbol) {
      symbol = (symbol || 'BTCUSDT').toUpperCase().replace(/[^A-Z0-9]/g, '');
      if (!symbol.endsWith('USDT')) symbol += 'USDT';
      market.symbol = symbol;

      try {
        // Ticker 24h
        const tRes = await fetch(`https://fapi.binance.com/fapi/v1/ticker/24hr?symbol=${symbol}`);
        if (!tRes.ok) throw new Error('Ticker failed');
        const t = await tRes.json();
        market.price = parseFloat(t.lastPrice);
        market.change24h = parseFloat(t.priceChangePercent);
        market.high24 = parseFloat(t.highPrice);
        market.low24 = parseFloat(t.lowPrice);

        // Premium index (mark, funding)
        const pRes = await fetch(`https://fapi.binance.com/fapi/v1/premiumIndex?symbol=${symbol}`);
        if (pRes.ok) {
          const p = await pRes.json();
          market.mark = parseFloat(p.markPrice);
          market.index = parseFloat(p.indexPrice);
          market.funding = parseFloat(p.lastFundingRate) * 100; // to %
        }

        // Open Interest
        const oiRes = await fetch(`https://fapi.binance.com/fapi/v1/openInterest?symbol=${symbol}`);
        if (oiRes.ok) {
          const oi = await oiRes.json();
          market.oi = parseFloat(oi.openInterest);
        }

        // Long/Short account ratio (top traders)
        const lsRes = await fetch(`https://fapi.binance.com/futures/data/topLongShortAccountRatio?symbol=${symbol}&period=1h&limit=1`);
        if (lsRes.ok) {
          const ls = await lsRes.json();
          if (ls && ls[0]) market.lsRatio = parseFloat(ls[0].longShortRatio);
        }

        updateMarketPanel();
        return true;
      } catch (e) {
        console.error(e);
        addMsg('agent', `<span class="text-rose-400">Failed to fetch live data for ${symbol}. Check symbol or try again later.</span>`);
        return false;
      }
    }

    function updateMarketPanel() {
      $('m-price').textContent = '$' + fmt(market.price, market.price > 100 ? 2 : 4);
      const ch = $('m-change');
      ch.textContent = fmtPct(market.change24h);
      ch.className = 'mono ' + (market.change24h >= 0 ? 'text-emerald-400' : 'text-rose-400');
      $('m-funding').textContent = market.funding != null ? fmt(market.funding, 4) + '%' : '—';
      $('m-funding').className = 'mono ' + (market.funding > 0.01 ? 'text-rose-300' : market.funding < -0.01 ? 'text-emerald-300' : '');
      $('m-oi').textContent = market.oi != null ? fmt(market.oi, 0) + ' contracts' : '—';
      $('m-ls').textContent = market.lsRatio != null ? fmt(market.lsRatio, 3) : '—';
      $('m-mark').textContent = market.mark ? `Mark ${fmt(market.mark, 2)} / Index ${fmt(market.index, 2)}` : '—';
    }

    // ========== AI Agent Logic (rule-based demo) ==========
    function generateSetup(stylePref = 'auto') {
      const price = market.price;
      if (!price) return null;

      const range = market.high24 - market.low24;
      const atrApprox = range * 0.35 || price * 0.015; // rough volatility proxy
      const funding = market.funding || 0;
      const change = market.change24h || 0;
      const ls = market.lsRatio || 1;

      // Direction bias
      let side = 'LONG';
      let scoreLong = 0;
      let scoreShort = 0;

      if (change > 1.5) scoreLong += 1.5;
      if (change < -1.5) scoreShort += 1.5;
      if (funding < -0.005) scoreLong += 1.2; // shorts pay longs → bullish pressure
      if (funding > 0.01) scoreShort += 1.2;  // longs pay shorts → crowded long
      if (ls < 0.9) scoreLong += 0.8;         // more shorts than longs among top traders
      if (ls > 1.3) scoreShort += 0.8;

      // Mean reversion vs mo
