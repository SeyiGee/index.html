<!DOCTYPE html>
<html lang="en" class="dark h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>CryptoBot - Futures & Research Assistant</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darker: '#090d16',
                        card: '#111622',
                        accent: '#2563eb',
                        success: '#10b981',
                        danger: '#ef4444'
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Telegram Web App SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        /* Prevent elastic bouncing on mobile and handle safe areas */
        body {
            overscroll-behavior-y: none;
            padding-top: env(safe-area-inset-top);
            padding-bottom: env(safe-area-inset-bottom);
        }
    </style>
</head>
<body class="bg-darker text-gray-100 font-sans antialiased h-full flex flex-col justify-between selection:bg-accent selection:text-white">

    <!-- App Container (Full Screen Mobile View) -->
    <div class="w-full h-full flex flex-col overflow-hidden bg-darker">
        
        <!-- Header -->
        <header class="bg-card px-4 py-3 border-b border-gray-800/80 flex justify-between items-center shrink-0">
            <div class="flex items-center space-x-2">
                <div class="w-2.5 h-2.5 rounded-full bg-success animate-pulse"></div>
                <span class="font-bold text-xs tracking-wider text-gray-200">AUTOBOT v2.0</span>
            </div>
            <div class="text-xs bg-gray-900 px-3 py-1.5 rounded-full text-gray-300 font-medium border border-gray-800 shadow-inner">
                Bal: $<span id="accountBalance">10,000.00</span>
            </div>
        </header>

        <!-- Main Scrollable Content Area -->
        <main class="flex-1 overflow-y-auto p-4 space-y-4">

            <!-- Asset Selector Tabs (Optimized touch targets) -->
            <div class="grid grid-cols-3 gap-2 bg-card p-1 rounded-xl border border-gray-800/80 shrink-0 shadow-sm">
                <button onclick="switchAsset('BTC/USDT')" id="tab-BTC" class="py-2.5 text-xs font-bold rounded-lg bg-accent text-white shadow transition active:scale-95">BTC/USDT</button>
                <button onclick="switchAsset('ETH/USDT')" id="tab-ETH" class="py-2.5 text-xs font-bold rounded-lg text-gray-400 hover:text-white transition active:scale-95">ETH/USDT</button>
                <button onclick="switchAsset('SOL/USDT')" id="tab-SOL" class="py-2.5 text-xs font-bold rounded-lg text-gray-400 hover:text-white transition active:scale-95">SOL/USDT</button>
            </div>

            <!-- Market Analyzer & Technical Card -->
            <div class="bg-card border border-gray-800/80 rounded-2xl p-4 space-y-3.5 shadow-sm">
                <div class="flex justify-between items-center">
                    <div>
                        <h2 id="assetTitle" class="text-base font-extrabold text-white tracking-wide">BTC / USDT</h2>
                        <p class="text-[11px] text-gray-400">Perpetual Futures • 1h Timeframe</p>
                    </div>
                    <div class="text-right">
                        <span id="currentPrice" class="text-base font-bold text-white">$64,250.00</span>
                        <p id="priceChange" class="text-xs text-success font-medium">+3.42%</p>
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-2 pt-1">
                    <div class="bg-gray-900/80 p-2.5 rounded-xl border border-gray-800 text-center">
                        <span class="text-[10px] text-gray-400 uppercase tracking-wider block">Trend</span>
                        <p id="marketTrend" class="text-xs font-bold text-success mt-1">BULLISH</p>
                    </div>
                    <div class="bg-gray-900/80 p-2.5 rounded-xl border border-gray-800 text-center">
                        <span class="text-[10px] text-gray-400 uppercase tracking-wider block">RSI (14)</span>
                        <p id="rsiValue" class="text-xs font-bold text-yellow-400 mt-1">58.4</p>
                    </div>
                    <div class="bg-gray-900/80 p-2.5 rounded-xl border border-gray-800 text-center">
                        <span class="text-[10px] text-gray-400 uppercase tracking-wider block">ATR</span>
                        <p id="atrValue" class="text-xs font-bold text-white mt-1">$480.00</p>
                    </div>
                </div>
            </div>

            <!-- Research Tools Quick Links -->
            <div class="space-y-2">
                <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider px-1">Research & On-Chain Tools</span>
                <div class="grid grid-cols-3 gap-2">
                    <a id="linkCoinglass" href="https://www.coinglass.com" target="_blank" class="flex items-center justify-center space-x-1.5 bg-card hover:bg-gray-800/80 border border-gray-800 py-3 px-2 rounded-xl text-xs font-medium text-gray-300 transition active:scale-95 shadow-sm">
                        <i class="fa-solid fa-chart-line text-blue-400"></i>
                        <span>Coinglass</span>
                    </a>
                    <a id="linkArkham" href="https://platform.arkhamintelligence.com" target="_blank" class="flex items-center justify-center space-x-1.5 bg-card hover:bg-gray-800/80 border border-gray-800 py-3 px-2 rounded-xl text-xs font-medium text-gray-300 transition active:scale-95 shadow-sm">
                        <i class="fa-solid fa-eye text-purple-400"></i>
                        <span>Arkham</span>
                    </a>
                    <a id="linkBubblemaps" href="https://bubblemaps.io" target="_blank" class="flex items-center justify-center space-x-1.5 bg-card hover:bg-gray-800/80 border border-gray-800 py-3 px-2 rounded-xl text-xs font-medium text-gray-300 transition active:scale-95 shadow-sm">
                        <i class="fa-solid fa-circle-nodes text-green-400"></i>
                        <span>Bubblemaps</span>
                    </a>
                </div>
            </div>

            <!-- Risk Management & Trade Plan Panel -->
            <div class="bg-card border border-gray-800/80 rounded-2xl p-4 space-y-3.5 shadow-sm">
                <div class="flex justify-between items-center">
                    <span class="text-xs font-semibold text-gray-300 uppercase tracking-wider">Risk Management Engine</span>
                    <span class="text-xs text-blue-400 font-semibold bg-blue-500/10 px-2 py-0.5 rounded-md">Risk: <span id="riskPctDisplay">1.0</span>%</span>
                </div>

                <!-- Range Sliders (Thumb size optimized for mobile touch) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                    <div class="bg-gray-900/50 p-3 rounded-xl border border-gray-800/60">
                        <div class="flex justify-between text-[11px] text-gray-400 mb-2">
                            <span>Leverage</span>
                            <span class="font-bold text-white"><span id="leverageVal">10</span>x</span>
                        </div>
                        <input type="range" id="leverageInput" min="1" max="50" value="10" class="w-full accent-blue-600 bg-gray-800 h-2 rounded-lg cursor-pointer" oninput="updateCalculations()">
                    </div>
                    <div class="bg-gray-900/50 p-3 rounded-xl border border-gray-800/60">
                        <div class="flex justify-between text-[11px] text-gray-400 mb-2">
                            <span>Risk per Trade</span>
                            <span class="font-bold text-white"><span id="riskPctVal">1.0</span>%</span>
                        </div>
                        <input type="range" id="riskInput" min="0.5" max="5.0" step="0.5" value="1.0" class="w-full accent-blue-600 bg-gray-800 h-2 rounded-lg cursor-pointer" oninput="updateCalculations()">
                    </div>
                </div>

                <!-- Trade Plan Breakdown -->
                <div class="bg-gray-900 rounded-xl p-3.5 border border-gray-800/80 space-y-2.5 text-xs">
                    <div class="flex justify-between">
                        <span class="text-gray-400">Entry Price:</span>
                        <span id="planEntry" class="font-mono font-bold text-white">$64,250.00</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400">Stop Loss (SL):</span>
                        <span id="planSL" class="font-mono font-bold text-danger">$63,530.00</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400">Take Profit (TP):</span>
                        <span id="planTP" class="font-mono font-bold text-success">$65,690.00</span>
                    </div>
                    <hr class="border-gray-800 my-1">
                    <div class="flex justify-between">
                        <span class="text-gray-400">Position Size:</span>
                        <span id="planSize" class="font-mono font-bold text-white">0.1560 BTC</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400">Required Margin:</span>
                        <span id="planMargin" class="font-mono font-bold text-blue-400">$1,002.34</span>
                    </div>
                </div>
            </div>

            <!-- Execution Status / Console Feedback -->
            <div id="consoleLog" class="hidden bg-card border border-gray-800 rounded-xl p-3 font-mono text-[11px] text-gray-300 space-y-1 shadow-sm">
                <p class="text-blue-400 font-bold"># System Execution Log</p>
                <p id="logMessage">Ready for command execution...</p>
            </div>

        </main>

        <!-- Sticky Footer Execution Action Buttons -->
        <footer class="bg-card px-4 py-3 border-t border-gray-800/80 shrink-0">
            <div class="grid grid-cols-2 gap-3">
                <button onclick="executeTrade('LONG')" class="w-full bg-success hover:bg-emerald-600 text-gray-950 font-extrabold py-3.5 px-4 rounded-xl shadow-lg transition active:scale-95 flex items-center justify-center space-x-2 text-sm">
                    <i class="fa-solid fa-rocket"></i>
                    <span>Execute Long</span>
                </button>
                <button onclick="executeTrade('SHORT')" class="w-full bg-danger hover:bg-red-600 text-white font-extrabold py-3.5 px-4 rounded
      <p id="logMessage">Ready for command execution...</p>
            </div>

        </div>

        <!-- Footer Bar -->
        <div class="bg-gray-900 px-4 py-2.5 border-t border-gray-800 text-center text-[11px] text-gray-500">
            Automated Futures & Risk Engine • Secure CCXT Tunnel Active
        </div>
    </div>

    <!-- JavaScript Logic -->
    <script>
        // Mock Market Database
        const marketData = {
            'BTC/USDT': { price: 64250.00, change: '+3.42%', trend: 'BULLISH', rsi: 58.4, atr: 480.00, slOffset: 720, tpOffset: 1440 },
            'ETH/USDT': { price: 3480.50, change: '+1.85%', trend: 'BULLISH', rsi: 62.1, atr: 45.00, slOffset: 65, tpOffset: 130 },
            'SOL/USDT': { price: 148.20, change: '-0.75%', trend: 'BEARISH', rsi: 44.2, atr: 3.50, slOffset: 5, tpOffset: 10 }
        };

        let currentAsset = 'BTC/USDT';
        let accountBalance = 10000.00;

        function switchAsset(symbol) {
            currentAsset = symbol;
            
            // Update Tab Styles
            ['BTC', 'ETH', 'SOL'].forEach(coin => {
                const btn = document.getElementById(`tab-${coin}`);
                if (coin === symbol.split('/')[0]) {
                    btn.className = "py-2 text-xs font-semibold rounded-lg bg-accent text-white shadow transition";
                } else {
                    btn.className = "py-2 text-xs font-semibold rounded-lg text-gray-400 hover:text-white transition";
                }
            });

            // Update UI elements
            const data = marketData[symbol];
            document.getElementById('assetTitle').innerText = symbol.replace('/', ' / ');
            document.getElementById('currentPrice').innerText = `$${data.price.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
            const changeEl = document.getElementById('priceChange');
            changeEl.innerText = data.change;
            changeEl.className = data.change.startsWith('+') ? 'text-xs text-success font-medium' : 'text-xs text-danger font-medium';
            
            document.getElementById('marketTrend').innerText = data.trend;
            document.getElementById('marketTrend').className = data.trend === 'BULLISH' ? 'text-xs font-bold text-success mt-0.5' : 'text-xs font-bold text-danger mt-0.5';
            document.getElementById('rsiValue').innerText = data.rsi;
            document.getElementById('atrValue').innerText = `$${data.atr.toFixed(2)}`;

            // Update Research links
            const base = symbol.split('/')[0].toLowerCase();
            document.getElementById('linkCoinglass').href = `https://www.coinglass.com/currencies/${base.toUpperCase()}`;
            document.getElementById('linkArkham').href = `https://platform.arkhamintelligence.com/explorer/token/${base}`;
            document.getElementById('linkBubblemaps').href = `https://bubblemaps.io/`;

            updateCalculations();
        }

        function updateCalculations() {
            const data = marketData[currentAsset];
            const leverage = parseInt(document.getElementById('leverageInput').value);
            const riskPct = parseFloat(document.getElementById('riskInput').value);

            document.getElementById('leverageVal').innerText = leverage;
            document.getElementById('riskPctDisplay').innerText = riskPct;

            const entry = data.price;
            let sl, tp;

            if (data.trend === 'BULLISH') {
                sl = entry - data.slOffset;
                tp = entry + data.tpOffset;
            } else {
                sl = entry + data.slOffset;
                tp = entry - data.tpOffset;
            }

            const riskAmount = accountBalance * (riskPct / 100);
            const priceRiskPerUnit = Math.abs(entry - sl);
            const positionUnits = riskAmount / priceRiskPerUnit;
            const notionalValue = positionUnits * entry;
            const requiredMargin = notionalValue / leverage;

            document.getElementById('planEntry').innerText = `$${entry.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
            document.getElementById('planSL').innerText = `$${sl.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
            document.getElementById('planTP').innerText = `$${tp.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
            document.getElementById('planSize').innerText = `${positionUnits.toFixed(4)} ${currentAsset.split('/')[0]}`;
            document.getElementById('planMargin').innerText = `$${requiredMargin.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
        }

        function executeTrade(side) {
            const consoleBox = document.getElementById('consoleLog');
            const logMsg = document.getElementById('logMessage');
            consoleBox.classList.remove('hidden');

            const timestamp = new Date().toLocaleTimeString();
            const leverage = document.getElementById('leverageInput').value;
            
            logMsg.innerHTML = `[${timestamp}] 🚀 Sending ${side} order for ${currentAsset} (${leverage}x) via CCXT...<br>` +
                               `<span class="text-success">[OK] Market entry, bracket SL & TP attached successfully!</span>`;
        }

        // Initialize on load
        window.onload = () => {
            updateCalculations();
        };
    </script>
</body>
</html>
